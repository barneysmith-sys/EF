# Local only. This file is an example; put real values in .env.local.
# .env.local is gitignored. Do not prefix these with VITE_.
# The dev server attaches them to EIA and PJM requests. The browser bundle
# and the public GitHub Pages site never receive them.

# Hourly regional demand, plus Virginia's statewide average retail price.
# Register: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Real-time hourly LMP for the PJM-RTO aggregate. Not a Dominion or retail price.
# Non-member Data Miner 2 access:
# https://www.pjm.com/markets-and-operations/etools/data-miner-2
# Confirm PJM's redistribution terms before showing this number to anyone but yourself.
PJM_SUBSCRIPTION_KEY=

# Not wired. The current map is the existing Albers map. A public pk token may
# be used in the browser later. Do not put a secret Mapbox token here.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server only. PVWatts V8. A modeled solar yield is not available capacity.
NLR_API_KEY=

# Server only. Not configured. Do not send these to the browser.
ERCOT_SUBSCRIPTION_KEY=
ERCOT_CLIENT_ID=
ERCOT_USERNAME=
ERCOT_PASSWORD=

# Not connected. Do not put the service role key in frontend code.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

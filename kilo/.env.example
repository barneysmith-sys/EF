# Both keys are free. Both are readable by anyone who loads the site,
# because Vite inlines VITE_ variables into the browser bundle.
# Use a key you are willing to expose. Do not put a secret here.

# Hourly demand for PJM, ERCOT, NYISO, ISO-NE and MISO.
# Register: https://www.eia.gov/opendata/register.php
VITE_EIA_API_KEY=

# Real-time hourly LMP for the PJM footprint (the East Coast pathways).
# Non-members can request Data Miner 2 API access:
# https://www.pjm.com/markets-and-operations/etools/data-miner-2
VITE_PJM_SUBSCRIPTION_KEY=
